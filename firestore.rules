rules_version = '2';

// FitPilot: each signed-in user can only read and write their own records.
// Path: users/{uid}/records/{recordId}; everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validRecord() {
      let d = request.resource.data;
      return d.keys().hasOnly(['c', 'json', 'deleted', 'updatedAt'])
        && d.keys().hasAll(['c', 'json', 'deleted', 'updatedAt'])
        && d.c is string && d.c.size() > 0 && d.c.size() <= 40
        && d.json is string && d.json.size() <= 900000
        && d.deleted is bool
        && (d.deleted == false || d.json.size() == 0)
        && d.updatedAt == request.time;
    }

    match /users/{uid}/records/{recordId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && recordId.size() <= 200 && validRecord();
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
